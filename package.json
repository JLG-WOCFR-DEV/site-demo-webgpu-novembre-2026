{
  "name": "pli",
  "private": true,
  "type": "module",
  "bin": {
    "presse": "tools/presse/cli.mjs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc --noEmit && node tools/build-legacy-nav.mjs && vite build",
    "bake": "node tools/bake.mjs && python3 tools/msdf.py && node tools/bake.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' 'tools/presse/*.test.ts' 'tools/gpu-verifier/*.test.ts'",
    "images": "python3 tools/images.py",
    "test:visual": "node tools/visual/run.mjs",
    "check": "node tools/presse-check.mjs",
    "valider": "node tools/valider-page.mjs",
    "skill:tableau": "node tools/gen-skill-tableau.mjs",
    "export:diapo": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/export-diapo.mjs",
    "urls:publiees": "node tools/gen-urls-publiees.mjs",
    "mesurer:effets": "node tools/mesurer-effets.mjs",
    "budgets": "node tools/budgets.mjs",
    "veille:paper": "node tools/veille-paper.mjs",
    "mouvement:audit": "node tools/mouvement-audit.mjs",
    "presse": "node tools/presse/cli.mjs",
    "presse:mcp": "node tools/presse/mcp.mjs",
    "gpu:verifier": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/gpu-verifier.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "@mapbox/tiny-sdf": "^2.3.0",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "meshoptimizer": "^1.3.0",
    "node-html-parser": "^9.0.7",
    "pixelmatch": "^8.0.0",
    "playwright": "1.62",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "webgpu": "^0.6.2"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.82",
    "webm-muxer": "^5.1.4"
  }
}
