{
  "name": "pli",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc --noEmit && node tools/build-legacy-nav.mjs && vite build",
    "bake": "node tools/bake.mjs && python3 tools/msdf.py && node tools/bake.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "carnet:wasm": "./tools/carnet-wasm.sh",
    "carnet:bench": "node --experimental-strip-types tools/carnet-bench-core.ts",
    "carnet:interruptions": "node tools/carnet-interruptions.mjs",
    "carnet:parity": "node tools/carnet-parity.mjs",
    "carnet:e2e": "node tools/carnet-e2e.mjs",
    "test": "node --experimental-strip-types --import ./tools/node-raw.mjs --test 'src/**/*.test.ts'",
    "images": "python3 tools/images.py",
    "test:visual": "node tools/visual/run.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mapbox/tiny-sdf": "^2.3.0",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "binaryen": "^123.0.0",
    "exifr": "^7.1.3",
    "fake-indexeddb": "^6.0.0",
    "meshoptimizer": "^0.22.0",
    "node-html-parser": "^6.1.13",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2",
    "webm-muxer": "^5.1.4"
  }
}
